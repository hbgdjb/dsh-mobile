<?xml version="1.0" encoding="utf-8"?>
<!--
  输入法声明。

  subtype 的 language 决定它出现在系统的哪一栏：
    zh-CN → 中文键盘
    en-US → 英文键盘

  两个都声明，用户在系统里能分别选"DSH 键盘（中文）"和"DSH 键盘（英文）"。
  只声明一个的话，用户切到英文输入场景时就找不到它了。
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="ai.deepseek.dsh.mobile.MainActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:icon="@mipmap/ic_launcher"
        android:imeSubtypeLocale="zh_CN"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true"
        android:label="DSH 键盘" />
    <subtype
        android:icon="@mipmap/ic_launcher"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true"
        android:label="DSH 键盘 (EN)" />
</input-method>
