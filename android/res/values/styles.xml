<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色状态栏：避免 WebView 顶部出现"看不见图标的空白条" -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">#08090B</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">#08090B</item>
        <item name="android:statusBarColor">#08090B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#08090B</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">#08090B</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
        原生启动图：Android 12+ 会先显示这段（系统启动图），然后才是 Web 里的动画。
        底色调成和动画一致（#0b0c0e），两段之间就没有跳变了。
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">#0B0C0E</item>
        <item name="android:statusBarColor">#0B0C0E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0B0C0E</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
